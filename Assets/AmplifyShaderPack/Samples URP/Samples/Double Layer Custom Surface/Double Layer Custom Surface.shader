				float fresnelNode385 = ( 0.05 + 1.0 * pow( 1.0 - fresnelNdotV385, 1.0 ) );
				float4 lerpResult395 = lerp( _BaseColor1 , _BaseColor2 , fresnelNode385);
				float4 lerpResult428 = lerp( _FlakesColor1 , _FlakesColor2 , fresnelNode385);
				float2 texCoord469 = input.ase_texcoord7.xy * (_FlakesRGBcolorvariationAmask_ST).xy + (_FlakesRGBcolorvariationAmask_ST).zw;
				float4 tex2DNode473 = tex2D( _FlakesRGBcolorvariationAmask, texCoord469 );
				float4 lerpResult396 = lerp( lerpResult428 , tex2DNode473 , _FlakeColorVariationAmount);
				float FlakeMask424 = tex2DNode473.a;
				float4 lerpResult420 = lerp( lerpResult395 , lerpResult396 , FlakeMask424);
				float fresnelNdotV379 = dot( NormalWS, ViewDirWS );
				float fresnelNode379 = ( 0.05 + 1.0 * pow( 1.0 - fresnelNdotV379, 5.0 ) );
				float lerpResult387 = lerp( input.ase_color.r , 1.0 , _BaseOcclusion);
				float Blend416 = saturate( ( ( fresnelNode379 * _CoatAmount ) * lerpResult387 ) );
				float4 lerpResult422 = lerp( lerpResult420 , float4( 0,0,0,0 ) , Blend416);
				#ifdef UNITY_COLORSPACE_GAMMA
				float4 staticSwitch442 = float4( 0.2209163, 0.2209163, 0.2209163, 0.7790837 );
				#else
				float4 staticSwitch442 = float4( 0.04, 0.04, 0.04, 0.96 );
				#endif
				float temp_output_441_0 = (staticSwitch442).w;
				float lerpResult406 = lerp( _BaseMetallic , _FlakesMetallic , FlakeMask424);
				float Metallic425 = lerpResult406;
				
				float3 unpack474 = UnpackNormalScale( tex2D( _FlakesNormal, texCoord469 ), _FlakesBump );
				unpack474.z = lerp( 1, unpack474.z, saturate(_FlakesBump) );
				float3 Normal1423 = unpack474;
				float2 uv_CoatNormal = input.ase_texcoord7.xy * _CoatNormal_ST.xy + _CoatNormal_ST.zw;
