					float Highlight_Level87 =  (_MinHighLightLevel + ( sin( ( mulTime138 * _HighlightSpeed ) ) - -1.0 ) * ( _MaxHighLightLevel - _MinHighLightLevel ) / ( 1.0 - -1.0 ) );
