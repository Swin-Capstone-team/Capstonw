					float2 temp_output_41_0 = ddy( ( ( IN.ase_texcoord2.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ) );
					

					o.Albedo = tex2D( _Albedo, OffsetPOM8, temp_output_40_0, temp_output_41_0 ).rgb;
