					float2 OffsetPOM8 = POM( _HeightMap, ( ( IN.ase_texcoord5.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ), ddx( ( ( IN.ase_texcoord5.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ) ), ddy( ( ( IN.ase_texcoord5.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ) ), NormalWS, ViewDirWS, ase_viewDirSafeTS, 128, 128, 10, _Scale, 0, _HeightMap_ST.xy, appendResult47, 0 );
					float2 temp_output_40_0 = ddx( ( ( IN.ase_texcoord5.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ) );
					float2 temp_output_41_0 = ddy( ( ( IN.ase_texcoord5.xy * _Albedo_ST.xy ) + _Albedo_ST.zw ) );
					

