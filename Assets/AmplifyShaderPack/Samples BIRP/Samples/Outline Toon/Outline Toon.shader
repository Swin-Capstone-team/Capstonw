						NormalWS = UnityObjectToWorldNormal(normalize(tex2D(_TerrainNormalmapTexture, sampleCoords).rgb * 2 - 1));
						TangentWS = -cross(unity_ObjectToWorld._13_23_33, NormalWS);
						BitangentWS = cross(NormalWS, -TangentWS);
					#endif

					float2 uv_MainTex = IN.ase_texcoord6.xy * _MainTex_ST.xy + _MainTex_ST.zw;
					float4 tex2DNode316 = tex2D( _MainTex, uv_MainTex );
					Gradient gradient321 = NewGradient( 0, 5, 2, float4( 0.254717, 0.254717, 0.254717, 0 ), float4( 0.3584906, 0.3584906, 0.3584906, 0.5000076 ), float4( 0.754717, 0.754717, 0.754717, 0.523537 ), float4( 0.8490566, 0.8490566, 0.8490566, 0.9382315 ), float4( 1, 1, 1, 0.9558862 ), 0, 0, 0, float2( 1, 0 ), float2( 1, 1 ), 0, 0, 0, 0, 0, 0 );
					float2 uv_Normal = IN.ase_texcoord6.xy * _Normal_ST.xy + _Normal_ST.zw;
					float3 tanToWorld0 = float3( TangentWS.x, BitangentWS.x, NormalWS.x );
					float3 tanToWorld1 = float3( TangentWS.y, BitangentWS.y, NormalWS.y );
					float3 tanToWorld2 = float3( TangentWS.z, BitangentWS.z, NormalWS.z );
					float3 tanNormal295 = UnpackScaleNormal( tex2D( _Normal, uv_Normal ), _NormalScale );
					float3 worldNormal295 = normalize( float3( dot( tanToWorld0, tanNormal295 ), dot( tanToWorld1, tanNormal295 ), dot( tanToWorld2, tanNormal295 ) ) );
					float3 ase_mainLightDirection = _WorldSpaceLightPos0.xyz;
					float dotResult302 = dot( worldNormal295 , ase_mainLightDirection );
					float3 ase_mainLightColorLDR = _LightColor0.rgb / ( _LightColor0.a + 1e-7 );
					float ase_mainLightIntensity = _LightColor0.a;
					float ase_mainLightShadowAtten = LightAtten.x;
					float3 temp_output_294_0 = ( ase_mainLightColorLDR * ase_mainLightIntensity * ase_mainLightShadowAtten );
					float3 break298 = temp_output_294_0;
					float3 mainLight309 = temp_output_294_0;
					float3 lerpResult317 = lerp( float3( 1,1,1 ) , mainLight309 , _RimShadow);
