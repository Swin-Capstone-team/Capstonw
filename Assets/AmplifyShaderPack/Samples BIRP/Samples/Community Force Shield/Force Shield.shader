					float VertexOffset271 =  (( _ShieldDistortion * -1.0 ) + ( simplePerlin3D66 - 0.0 ) * ( _ShieldDistortion - ( _ShieldDistortion * -1.0 ) ) / ( 1.0 - 0.0 ) );
