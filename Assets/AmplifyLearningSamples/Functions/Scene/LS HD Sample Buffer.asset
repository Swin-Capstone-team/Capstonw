    Unity_HDRP_SampleBuffer_NormalWorldSpace_float(float2 uv, int layerID)${$uint2
    pixelCoords = uint2(uv * _ScreenSize.xy)@$NormalData normalData@$DecodeFromNormalBuffer(pixelCoords,
    normalData)@$return normalData.normalWS@$}$;0;0\nNode;AmplifyShaderEditor.StickyNoteNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;102;384,-1056;Inherit;False;850.4971;231.1148;Smoothness;;0,0,0,1;$$float1
    Unity_HDRP_SampleBuffer_Smoothness_float(float2 uv, int layerID)${$uint2 pixelCoords
    = uint2(uv * _ScreenSize.xy)@$NormalData normalData@$DecodeFromNormalBuffer(pixelCoords,
    normalData)@$return IsSky(pixelCoords) ? 1 : RoughnessToPerceptualSmoothness(PerceptualRoughnessToRoughness(normalData.perceptualRoughness))@$};0;0\nNode;AmplifyShaderEditor.StickyNoteNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;103;384,-800;Inherit;False;855.5264;220.1579;MotionVectors;;0,0,0,1;$$float2
