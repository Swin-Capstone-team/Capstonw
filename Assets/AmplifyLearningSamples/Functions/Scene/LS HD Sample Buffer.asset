    = uint2(uv * _ScreenSize.xy)@$float4 motionVecBufferSample = LOAD_TEXTURE2D_X_LOD(_CameraMotionVectorsTexture,
    pixelCoords, 0)@$float2 motionVec@$DecodeMotionVector(motionVecBufferSample,
    motionVec)@$return motionVec@$};0;0\nNode;AmplifyShaderEditor.StickyNoteNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;104;384,-560;Inherit;False;857.3012;166.3011;IsSky;;0,0,0,1;$$float1
    Unity_HDRP_SampleBuffer_IsSky_float(float2 uv, int layerID)${$return IsSky(uv)
