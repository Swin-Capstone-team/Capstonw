    HDRP 17+;;0,0,0,1;$$float1 Unity_HDRP_SampleBuffer_RenderingLayerMask_float(float2
    uv, int layerID)${$uint2 pixelCoords = uint2(uv * _ScreenSize.xy)@$return _EnableRenderingLayers
