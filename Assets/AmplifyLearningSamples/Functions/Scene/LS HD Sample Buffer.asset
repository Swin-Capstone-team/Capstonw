    Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;105;384,-384;Inherit;False;864.69;182.1732;PostProcessInput;;0,0,0,1;$$TEXTURE2D_X(_CustomPostProcessInput)@$float4
    Unity_HDRP_SampleBuffer_PostProcessInput_float(float2 uv, int layerID)${$uint2
    pixelCoords = uint2(uv * _ScreenSize.xy)@$return LOAD_TEXTURE2D_X_LOD(_CustomPostProcessInput,
    pixelCoords, 0)@$};0;0\nNode;AmplifyShaderEditor.StickyNoteNode, AmplifyShaderEditor,
