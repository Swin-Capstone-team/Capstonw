    Direction vs View Vector;9;185;184;95;91;110;126;179;109;186;;0.02830189,0.02830189,0.02830189,1;0;0\nNode;AmplifyShaderEditor.CommentaryNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;109;603.5974,1328;Inherit;False;709.7331;331.4401;Distance
    From The Camera;3;118;111;181;;0,0,0,1;0;0\nNode;AmplifyShaderEditor.CommentaryNode,
